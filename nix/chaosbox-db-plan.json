{
  "version": 1,
  "name": "chaosbox",
  "operations": [
    {
      "id": "migrations",
      "kind": "database",
      "lifecycle": "ensure",
      "backend": "gel",
      "phase": "schema",
      "safety": "automatic",
      "apply": {
        "program": "gel",
        "args": ["migration", "apply", "--non-interactive"],
        "credential_environment": {
          "CHAOSBOX_GEL_CREDENTIALS_FILE": "chaosbox-gel-credentials"
        }
      },
      "check": {
        "program": "chaosbox",
        "args": ["db", "check", "--json"],
        "credential_environment": {
          "CHAOSBOX_GEL_CREDENTIALS_FILE": "chaosbox-gel-credentials"
        }
      },
      "depends_on": []
    },
    {
      "id": "readiness",
      "kind": "database",
      "lifecycle": "ensure",
      "backend": "gel",
      "phase": "backfill",
      "safety": "automatic",
      "apply": {
        "program": "chaosbox",
        "args": ["db", "check", "--json"],
        "credential_environment": {
          "CHAOSBOX_GEL_CREDENTIALS_FILE": "chaosbox-gel-credentials"
        }
      },
      "depends_on": ["migrations"]
    }
  ]
}
