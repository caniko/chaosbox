{
  "purpose": "byte-exact acceptance test for a re-implementation of chaosbox/variant-session-id/v1 and chaosbox/variant-message-id/v1",
  "spec": {
    "hash": "SHA-256 of the seed string encoded as UTF-8 bytes",
    "separator": "single NUL byte 0x00 between every field",
    "attemptTag": {
      "attempt": 0,
      "tag": "<empty>",
      "otherwise": "NUL byte 0x00 followed by the ASCII text `attempt=` and the decimal attempt with no padding"
    },
    "session": {
      "seed": "chaosbox.variant-session-id.v1",
      "fields": [
        "seed",
        "variantSource",
        "canonicalID",
        "attemptTag"
      ],
      "algorithm": "chaosbox/variant-session-id/v1",
      "prefix": "ses",
      "hex12": "first 6 hash bytes, lowercase hex (12 chars)",
      "suffix14": {
        "input": "hash bytes 6..31 (26 bytes) as a big-endian unsigned integer",
        "reduce": "integer modulo 62^14",
        "render": "14 digits, most significant first, digit i = value / 62^i mod 62, mapped through BASE62",
        "alphabet": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz",
        "alphabetOrder": "0-9, A-Z, a-z — digits are values 0..9, upper case 10..35, lower case 36..61"
      },
      "shape": "ses_[0-9a-f]{12}[0-9A-Za-z]{14} — 30 characters total"
    },
    "message": {
      "seed": "chaosbox.variant-message-id.v1",
      "fields": [
        "seed",
        "derivedSessionID",
        "originalMessageID",
        "attemptTag"
      ],
      "algorithm": "chaosbox/variant-message-id/v1",
      "prefix": "msg",
      "hex12": "first 6 hash bytes, lowercase hex (12 chars)",
      "suffix14": "identical to the session rule above",
      "shape": "msg_[0-9a-f]{12}[0-9A-Za-z]{14} — 30 characters total"
    },
    "note": "The 14-character suffix is NOT the raw base62 of the remaining 26 bytes; it is that integer reduced modulo 62^14. Treating it as a fixed-length base62 encoding without the modulus reproduces nothing."
  },
