{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./plugins/chaosbox-compaction",
      "options": {
        "work": "/absolute/private/chaosbox-memory",
        "scope": "private:can",
        "repo": "chaosbox",
        "liveAssessment": true,
        "publish": true,
        "maxRequests": 1000,
        "maxInputTokens": 10000000,
        "maxChars": 60000,
      },
    },
  ],
}
